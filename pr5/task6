import math
def calculate_distance(x1, y1, x2, y2):
    '''Вычисляет площадь треугольника и возвращает'''
    return math.sqrt((x2-x1) **2 + (y2-y1) ** 2)
def calculate_rectangle_area(a, b, c):
    '''Вычисляет площадь треугольника и возвращает'''
    p = (a + b + c) / 2 
    plojad = math.sqrt(p *(p - a) * (p - b )* (p - c))
    return plojad
